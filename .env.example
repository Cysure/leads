# Copy to .env (never commit it). Used by `npm run sync` and `npm run adduser` on this machine.
# Neon connection string (Vercel > Storage > your Neon database > .env.local tab, the pooled DATABASE_URL).
DEALFLOW_DATABASE_URL=
# Vercel Blob token (Vercel > Storage > your Blob store > .env.local tab).
BLOB_READ_WRITE_TOKEN=
